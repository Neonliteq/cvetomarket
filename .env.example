# =============================================================================
# ЦветоМаркет — переменные окружения (шаблон)
# =============================================================================
# Скопируйте в .env и заполните реальными значениями. Файл .env в git не попадает.
#
# Минимум для локального запуска: DATABASE_URL, SESSION_SECRET.
# Полные пояснения по каждому блоку — deploy/.env.example
# =============================================================================

# --- Приложение ---
NODE_ENV=development
PORT=5000

# --- База данных ---
# Локально в этом проекте используется портативный PostgreSQL на порту 5433
DATABASE_URL=postgresql://user:password@localhost:5433/cvetomarket

# --- Сессии (openssl rand -hex 32) ---
SESSION_SECRET=replace_with_random_string

# --- Reg.ru S3 (резерв для файлов; основной источник — локальное зеркало uploads/) ---
REGRU_S3_ACCESS_KEY=
REGRU_S3_SECRET_KEY=
REGRU_S3_BUCKET=
REGRU_S3_ENDPOINT=https://s3.regru.ru
REGRU_S3_REGION=ru-1

# --- Яндекс Карты (карта доставки, геокодинг) ---
VITE_YANDEX_MAPS_API_KEY=

# --- Robokassa (приём оплаты картой) ---
# Режим: ROBOKASSA_TEST (или ROBOKASSA_IS_TEST) = true/1/yes/on → тестовый
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST=false

# --- Уведомления ---
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
MAX_BOT_NICK=
RESEND_API_KEY=

# --- Web Push (npx web-push generate-vapid-keys) ---
# ВНИМАНИЕ: смена ключей инвалидирует все существующие подписки браузеров
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Легаси-имя Replit: домен для регистрации вебхуков Telegram/MAX в production ---
REPLIT_DOMAINS=
